# ====================================================
# MediConsent Environment Configuration (.env)
# NEVER commit your actual .env file or private keys!
# ====================================================

# RPC Endpoints
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# Deployment Wallet (Must have testnet POL for gas)
# Amoy Faucet: https://faucet.polygon.technology/
PRIVATE_KEY=your_private_key_without_0x_prefix_here

# Etherscan / Polygonscan API Key for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional: IPFS Pinata API credentials (for backend off-chain storage)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_token_here
