# ====================================================
# MediConsent Backend Environment Variables
# ====================================================

# Port for Express server
PORT=5001

# Allowed Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# Storage Mode: Set to true to force local file storage, or leave false to use Pinata when JWT is provided
USE_LOCAL_STORAGE=true

# Maximum file size in megabytes (Default: 25)
MAX_FILE_SIZE_MB=25

# Pinata IPFS Credentials (Required only for production IPFS pinning)
# Get a free API JWT key at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
